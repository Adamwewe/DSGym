<python>
# Feature engineering on the mock training data
def calculate_gc_content(sequence):
    """Calculate the GC content of a given RNA sequence."""
    g_count = sequence.count('G')
    c_count = sequence.count('C')
    return (g_count + c_count) / len(sequence)

# Add new features to the training data
train_data['GC_content'] = train_data['sequence'].apply(calculate_gc_content)
train_data['seq_length'] = train_data['sequence'].apply(len)

# Check the updated dataframe
feature_summary = train_data[['id', 'seq_length', 'GC_content']].describe()
