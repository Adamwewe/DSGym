# Step 1: Load and explore datasets using TensorFlow's TFRecord reader

import tensorflow as tf
import pandas as pd

# Define paths to the dataset
train_data_path = '/data/dspredict-hard/youtube8m-2018/train'
test_data_path = '/data/dspredict-hard/youtube8m-2018/test'

# Function to load TFRecord files
def load_tfrecords(file_path):
    raw_dataset = tf.data.TFRecordDataset(file_path)
    return raw_dataset

# Load training and test datasets
train_dataset = load_tfrecords(train_data_path)
test_dataset = load_tfrecords(test_data_path)

# Function to parse the TFRecord
def parse_tfrecord(example_proto):
    feature_description = {
        'id': tf.io.FixedLenFeature([], tf.string),
        'labels': tf.io.VarLenFeature(tf.int64),
        'mean_rgb': tf.io.FixedLenFeature([1024], tf.float32),
        'mean_audio': tf.io.FixedLenFeature([128], tf.float32),
    }
    return tf.io.parse_single_example(example_proto, feature_description)

# Parse the datasets
train_dataset = train_dataset.map(parse_tfrecord)
test_dataset = test_dataset.map(parse_tfrecord)

# Explore the training dataset
for record in train_dataset.take(5):
    print("Video ID:", record['id'].numpy().decode('utf-8'))
    print("Labels:", record['labels'].values.numpy())
    print("Mean RGB Features:", record['mean_rgb'].numpy())
    print("Mean Audio Features:", record['mean_audio'].numpy())
    print("\n")
</python>
