# Step 7: Model Training with New Features

# Prepare features and target variable with the new feature set
X_new = mock_train_df_features.drop(columns=['seq_id', 'tm'])
y_new = mock_train_df_features['tm']

# Split the data into training and validation sets
X_train_new, X_val_new, y_train_new, y_val_new = train_test_split(X_new, y_new, test_size=0.2, random_state=42)

# Initialize the Random Forest Regressor
rf_model_new = RandomForestRegressor(n_estimators=100, random_state=42)

# Fit the model on the new training data
rf_model_new.fit(X_train_new, y_train_new)

# Make predictions on the validation set
y_val_pred_new = rf_model_new.predict(X_val_new)

# Calculate the Spearman's correlation coefficient for the new model
