# Simple pixel-wise classification based on intensity thresholding
def simple_nucleus_detection(image, threshold=0.5):
    # Convert the image to binary based on the threshold
    binary_mask = (image > threshold).astype(np.uint8)
    return binary_mask

# Apply the simple nucleus detection to the training images
simple_masks = []
for image in X_train_split:
    simple_mask = simple_nucleus_detection(image)
    simple_masks.append(simple_mask)

# Convert to numpy array
simple_masks = np.array(simple_masks)

# Check the shapes of the simple masks
print("Simple Masks Shape:", simple_masks.shape)
print("Unique values in Simple Masks:", np.unique(simple_masks))
