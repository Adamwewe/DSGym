    'min_samples_split': [2, 5, 10]
}

# Random search for hyperparameter tuning
random_search = RandomizedSearchCV(model, param_distributions=param_grid, n_iter=10, cv=3, verbose=2)
random_search.fit(X_train, y_train)

# Best parameters
best_params = random_search.best_params_
print(f"Best Hyperparameters: {best_params}")
```

### Step 5: Prediction Generation
```python
# Generate predictions for the test dataset
test_data_path = '/data/dspredict-hard/youtube8m-2019/test/*.tfrecord'
test_dataset = tf.data.TFRecordDataset(tf.io.gfile.glob(test_data_path))
parsed_test_dataset = test_dataset.map(parse_tfrecord)

# Preprocess test dataset
preprocessed_test_dataset = preprocess_data(parsed_test_dataset)

# Convert test dataset to DataFrame
test_df = dataset_to_dataframe(preprocessed_test_dataset)

# Make predictions
predictions = model.predict(list(test_df['rgb']))

# Prepare submission format
submission = pd.DataFrame({
    'Class': test_df['id'],
    'Segments': predictions
})

# Save submission file
submission.to_csv('/submission/submission.csv', index=False)
```
