<python>
import numpy as np

# Function to manually augment images
def manual_augment(image, mask):
    augmented_images = []
    augmented_masks = []
    
    # Original image and mask
    augmented_images.append(image)
    augmented_masks.append(mask)
    
    # Flip horizontally
    augmented_images.append(np.fliplr(image))
    augmented_masks.append(np.fliplr(mask))
    
    # Flip vertically
    augmented_images.append(np.flipud(image))
    augmented_masks.append(np.flipud(mask))
    
    # Rotate 90 degrees
    augmented_images.append(np.rot90(image))
    augmented_masks.append(np.rot90(mask))
    
    return np.array(augmented_images), np.array(augmented_masks)

# Apply manual augmentation to the single training sample
X_train_augmented, y_train_augmented = manual_augment(X_train[0], y_train[0])

# Combine original and augmented data
X_train_combined = np.concatenate((X_train, X_train_augmented), axis=0)
y_train_combined = np.concatenate((y_train, y_train_augmented), axis=0)

# Check the shapes of the combined training data
print("Combined Training Data Shape:", X_train_combined.shape)
print("Combined Training Masks Shape:", y_train_combined.shape)

# Split the combined dataset into training and validation sets
X_train_split, X_val_split, y_train_split, y_val_split = train_test_split(X_train_combined, y_train_combined, test_size=0.2, random_state=42)
