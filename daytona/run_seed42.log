### Outlier Detection:
```python
# Calculate IQR for non-zero values
Q1 = np.percentile(non_zero_values, 25)
Q3 = np.percentile(non_zero_values, 75)
IQR = Q3 - Q1

# Define outlier bounds
lower_bound = Q1 - 1.5 * IQR
upper_bound = Q3 + 1.5 * IQR

# Identify outliers
outliers = non_zero_values[(non_zero_values < lower_bound) | (non_zero_values > upper_bound)]
print("Outliers Count:", outliers.size)
print("Outliers Range: Min =", outliers.min(), ", Max =", outliers.max())
