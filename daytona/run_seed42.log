
    # Create a mapping from label to integer
    label_mapping = {label: idx for idx, label in enumerate(unique_labels, start=1)}
    
    # Encode the labels in the dataset
    dataset['encoded_labels'] = dataset['labels'].apply(lambda x: [label_mapping[label] for label in x])
