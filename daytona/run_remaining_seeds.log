# Step 2: Data Preprocessing

from sklearn.preprocessing import MultiLabelBinarizer
from sklearn.preprocessing import StandardScaler

# Initialize the MultiLabelBinarizer for encoding labels
mlb = MultiLabelBinarizer()

# Encode the labels for the training and test datasets
train_labels_encoded = mlb.fit_transform(train_df['labels'])
test_labels_encoded = mlb.transform(test_df['labels'])

# Create DataFrames for the encoded labels
train_labels_df = pd.DataFrame(train_labels_encoded, columns=mlb.classes_)
test_labels_df = pd.DataFrame(test_labels_encoded, columns=mlb.classes_)

# Scale the RGB and audio features
scaler_rgb = StandardScaler()
scaler_audio = StandardScaler()

# Scale RGB features
train_rgb_scaled = scaler_rgb.fit_transform(pd.DataFrame(train_df['rgb'].tolist()))
test_rgb_scaled = scaler_rgb.transform(pd.DataFrame(test_df['rgb'].tolist()))

# Scale audio features
train_audio_scaled = scaler_audio.fit_transform(pd.DataFrame(train_df['audio'].tolist()))
test_audio_scaled = scaler_audio.transform(pd.DataFrame(test_df['audio'].tolist()))

# Combine scaled features and encoded labels into final DataFrames
train_processed_df = pd.concat([train_labels_df, pd.DataFrame(train_rgb_scaled), pd.DataFrame(train_audio_scaled)], axis=1)
test_processed_df = pd.concat([test_labels_df, pd.DataFrame(test_rgb_scaled), pd.DataFrame(test_audio_scaled)], axis=1)

# Display the first few rows of the processed training DataFrame
print("Processed Training DataFrame:")
print(train_processed_df.head())

# Display the first few rows of the processed test DataFrame
print("\nProcessed Test DataFrame:")
print(test_processed_df.head())
