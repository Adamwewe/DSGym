
# Function to preprocess audio files
def preprocess_audio(data_path, processed_path):
    for label in os.listdir(data_path):
        label_path = os.path.join(data_path, label)
        if os.path.isdir(label_path):
            for file in os.listdir(label_path):
                if file.endswith('.wav'):
                    # Load audio file
                    with wave.open(os.path.join(label_path, file), 'rb') as wav_file:
                        frames = wav_file.getnframes()
                        rate = wav_file.getframerate()
                        duration = frames / float(rate)
                        
                        # Check if duration is 1 second
                        if duration == 1.0:
                            # Copy the file to the processed directory
                            shutil.copy(os.path.join(label_path, file), os.path.join(processed_path, label + '_' + file))
                        elif duration < 1.0:
                            # Pad the audio file with silence
                            silence_duration = 1.0 - duration
                            silence_frames = int(silence_duration * rate)
                            audio_data = wav_file.readframes(frames)
                            padded_audio = audio_data + b'\x00' * silence_frames * 2  # 16-bit audio
                            with wave.open(os.path.join(processed_path, label + '_' + file), 'wb') as new_wav_file:
                                new_wav_file.setnchannels(1)
                                new_wav_file.setsampwidth(2)  # 16-bit
                                new_wav_file.setframerate(rate)
                                new_wav_file.writeframes(padded_audio)
                        # Note: For audio files longer than 1 second, we will skip them for now

# Preprocess training data
preprocess_audio(train_data_path, processed_train_data_path)
