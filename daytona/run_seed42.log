
# Calculate win/loss ratios for teams in tournament results
tourney_win_loss = tourney_results.groupby('WTeamID').size().reset_index(name='Wins')
tourney_loss = tourney_results.groupby('LTeamID').size().reset_index(name='Losses')
tourney_win_loss = pd.merge(tourney_win_loss, tourney_loss, left_on='WTeamID', right_on='LTeamID', how='outer').fillna(0)
tourney_win_loss['TotalGames'] = tourney_win_loss['Wins'] + tourney_win_loss['Losses']
tourney_win_loss['WinRatio'] = tourney_win_loss['Wins'] / tourney_win_loss['TotalGames']

# Summary statistics for win/loss ratios
win_loss_summary = tourney_win_loss.describe()

