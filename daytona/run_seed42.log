<python>
import os
import pandas as pd
import numpy as np
import librosa

# Define paths
train_path = '/data/dspredict-hard/tensorflow-speech-recognition-challenge/train'
test_path = '/data/dspredict-hard/tensorflow-speech-recognition-challenge/test'

# Load training data
train_labels = os.listdir(train_path)
train_files = []
for label in train_labels:
    label_path = os.path.join(train_path, label)
    if os.path.isdir(label_path):
        for file in os.listdir(label_path):
            if file.endswith('.wav'):
                train_files.append((os.path.join(label, file), label))

# Create DataFrame for training data
train_df = pd.DataFrame(train_files, columns=['file_path', 'label'])

# Check shape and basic statistics
print("Training Data Shape:", train_df.shape)
print("Training Data Types:", train_df.dtypes)

# Check for missing values
missing_count = train_df.isnull().sum().sum()
print("Missing Values Count:", missing_count)

# Check for duplicates
duplicate_count = train_df.duplicated().sum()
print("Duplicate Count:", duplicate_count)

# Analyze audio lengths
audio_lengths = []
for file_path in train_df['file_path']:
    audio, sr = librosa.load(os.path.join(train_path, file_path), sr=16000)
    audio_lengths.append(len(audio) / sr)  # Length in seconds

train_df['audio_length'] = audio_lengths
print("Audio Length Statistics:")
print(train_df['audio_length'].describe())

# Class distribution
class_distribution = train_df['label'].value_counts()
print("Class Distribution:")
print(class_distribution)

# Check for outliers in audio lengths
outlier_threshold = train_df['audio_length'].quantile(0.95)
outliers = train_df[train_df['audio_length'] > outlier_threshold]
print("Outliers in Audio Lengths:")
print(outliers)

# Check for class imbalance
class_imbalance = class_distribution / len(train_df)
print("Class Imbalance Ratios:")
print(class_imbalance)

