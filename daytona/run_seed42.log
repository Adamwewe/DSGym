
# Function to extract features from audio files
def extract_features(data_path):
    features = []
    labels = []
    
    for label in os.listdir(data_path):
        label_path = os.path.join(data_path, label)
        if os.path.isdir(label_path):
            for file in os.listdir(label_path):
                if file.endswith('.wav'):
                    # Load audio file
                    file_path = os.path.join(label_path, file)
                    audio, sr = librosa.load(file_path, sr=16000)  # Load with a sample rate of 16kHz
                    
                    # Extract MFCCs
                    mfccs = librosa.feature.mfcc(y=audio, sr=sr, n_mfcc=13)
                    mfccs_mean = np.mean(mfccs.T, axis=0)  # Take the mean of MFCCs across time
                    
                    features.append(mfccs_mean)
                    labels.append(label)
    
    return np.array(features), np.array(labels)

# Extract features from processed training data
X_train, y_train = extract_features(processed_train_data_path)
