# Step 1: Load the training and test datasets
import pandas as pd

# Define the paths for the datasets
train_data_path = '/data/dspredict-hard/mens-machine-learning-competition-2018/RegularSeasonCompactResults.csv'
test_data_path = '/data/dspredict-hard/mens-machine-learning-competition-2018/NCAATourneyCompactResults.csv'

# Load the datasets
train_data = pd.read_csv(train_data_path)
