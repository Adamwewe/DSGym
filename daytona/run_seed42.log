# Step 6: Feature Engineering

# Function to calculate amino acid composition
def amino_acid_composition(sequence):
    amino_acids = 'ACDEFGHIKLMNPQRSTVWY'
    composition = {aa: 0 for aa in amino_acids}
    for aa in sequence:
        if aa in composition:
            composition[aa] += 1
    return composition

# Create a DataFrame to hold the amino acid composition features
composition_df = pd.DataFrame(mock_train_df_encoded['protein_sequence'].apply(amino_acid_composition).tolist())

# Concatenate the composition features with the existing training DataFrame
mock_train_df_features = pd.concat([mock_train_df_encoded.drop(columns=['protein_sequence']), composition_df], axis=1)

# Display the first few rows of the new feature DataFrame
mock_train_df_features_preview = mock_train_df_features.head()

# Display the shape of the new feature DataFrame
mock_train_df_features_shape = mock_train_df_features.shape

mock_train_df_features_preview, mock_train_df_features_shape
