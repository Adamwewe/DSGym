# Function to decode RLE (Run-Length Encoding) into a binary mask
def rle_decode(mask_rle, shape):
    """Decode run-length encoding to binary mask."""
    s = np.fromstring(mask_rle, sep=' ', dtype=int)
    starts, lengths = s[0::2] - 1, s[1::2]
    ends = starts + lengths
    img = np.zeros(shape[0] * shape[1], dtype=np.uint8)
    for start, end in zip(starts, ends):
        img[start:end] = 1
    return img.reshape(shape).T  # Return as a 2D array

# Example of decoding the first mask
import numpy as np

# Decode the first mask to visualize
first_mask_rle = train_data['EncodedPixels'].iloc[0]
mask_shape = (1024, 1024)  # Assuming the images are 1024x1024
decoded_mask = rle_decode(first_mask_rle, mask_shape)

# Print the shape of the decoded mask
print(f"Decoded mask shape: {decoded_mask.shape}")
print(f"Unique values in the decoded mask: {np.unique(decoded_mask)}")
</python>
