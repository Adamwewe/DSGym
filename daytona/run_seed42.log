# Function to load datasets
def load_datasets(collections):
    datasets = {}
    for collection in collections:
        datasets[collection] = []
        collection_path = os.path.join(data_path, collection)
        for split in ['train', 'valid', 'test']:
            for file in os.listdir(os.path.join(collection_path, split)):
                if file.endswith('.npz'):
                    file_path = os.path.join(collection_path, split, file)
                    data = dict(np.load(file_path))
                    datasets[collection].append(data)
    return datasets

# Specify the collections to load
collections = ['tile/xla', 'layout/xla/random', 'layout/xla/default', 'layout/nlp/random', 'layout/nlp/default']
