# Function to parse TFRecord files
def parse_tfrecord(example_proto):
    feature_description = {
        'id': tf.io.FixedLenFeature([], tf.string),
        'labels': tf.io.VarLenFeature(tf.int64),
        'mean_rgb': tf.io.FixedLenFeature([1024], tf.float32),
        'mean_audio': tf.io.FixedLenFeature([128], tf.float32),
    }
    return tf.io.parse_single_example(example_proto, feature_description)

# Load the datasets
train_data = tf.data.TFRecordDataset(train_data_path).map(parse_tfrecord)
test_data = tf.data.TFRecordDataset(test_data_path).map(parse_tfrecord)

# Check the shapes and types
for record in train_data.take(1):
