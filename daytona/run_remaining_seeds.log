# Step 1: Load Training and Test Datasets
import numpy as np
import os

# Define the data path
data_path = '/data/dspredict-hard/predict-ai-model-runtime/npz'

# Function to load datasets
def load_datasets(collections):
    datasets = {}
    for collection in collections:
        datasets[collection] = []
        collection_path = os.path.join(data_path, collection)
        for file in os.listdir(collection_path):
            if file.endswith('.npz'):
                file_path = os.path.join(collection_path, file)
                datasets[collection].append(dict(np.load(file_path)))
    return datasets

# Load the datasets for tile and layout collections
collections = ['tile/xla/train', 'layout/xla/random/train', 'layout/xla/default/train', 'layout/nlp/random/train', 'layout/nlp/default/train']
datasets = load_datasets(collections)

# Check the loaded datasets
for collection, data in datasets.items():
    print(f"Loaded {len(data)} files from {collection}")
